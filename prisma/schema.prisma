generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                    @id @db.Uuid
  role                 UserRole                  @default(USER)
  name                 String
  email                String                    @unique
  avatar               String?
  isVerified           Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  deletedAt            DateTime?
  buyerConversations   Conversation[]            @relation("BuyerConversations")
  sellerConversations  Conversation[]            @relation("SellerConversations")
  participants         ConversationParticipant[]
  listings             Listing[]                 @relation("SellerListings")
  transactionsAsBuyer  ListingTransaction[]      @relation("TransactionBuyer")
  transactionsAsSeller ListingTransaction[]      @relation("TransactionSeller")
  messages             Message[]

  @@index([createdAt])
}

model Listing {
  id            String               @id @default(uuid()) @db.Uuid
  slug          String               @unique
  title         String
  description   String
  price         Float
  originalPrice Float?
  category      String
  condition     String
  status        ListingStatus        @default(ACTIVE)
  imageUrl      String?
  imageUrls     String[]             @default([])
  negotiable    Boolean              @default(false)
  tags          String[]             @default([])
  department    String?
  sellerId      String               @db.Uuid
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
  conversations Conversation[]
  seller        User                 @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  transactions  ListingTransaction[]
  reservations  Reservation[]

  @@index([status])
  @@index([category])
  @@index([sellerId])
  @@index([createdAt])
  @@index([slug])
}

model Conversation {
  id                String                    @id @default(uuid()) @db.Uuid
  listingId         String                    @db.Uuid
  buyerId           String                    @db.Uuid
  sellerId          String                    @db.Uuid
  conversationStage ConversationStage         @default(NEGOTIATING)
  lastActivityAt    DateTime                  @default(now())
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  archivedAt        DateTime?
  lastMessageId     String?
  buyer             User                      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  listing           Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller            User                      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  participants      ConversationParticipant[]
  meetupLocations   MeetupLocation[]
  messages          Message[]
  reservations      Reservation[]

  @@index([createdAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  role           String
  unreadCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([createdAt])
}

model Message {
  id              String        @id @default(uuid()) @db.Uuid
  serverMessageId String        @unique @default(uuid()) @db.Uuid
  clientTempId    String?
  conversationId  String        @db.Uuid
  senderId        String        @db.Uuid
  messageType     MessageType   @default(TEXT)
  messageStatus   MessageStatus @default(SENT)
  content         String?
  attachmentUrl   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model MeetupLocation {
  id                String       @id @default(uuid()) @db.Uuid
  conversationId    String       @db.Uuid
  title             String
  address           String?
  latitude          Float?
  longitude         Float?
  meetupTime        DateTime?
  confirmedByBuyer  Boolean      @default(false)
  confirmedBySeller Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Reservation {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @db.Uuid
  listingId      String               @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  transactions   ListingTransaction[]
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listing        Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ListingTransaction {
  id                   String                  @id @default(uuid()) @db.Uuid
  listingId            String                  @db.Uuid
  reservationId        String?                 @db.Uuid
  buyerId              String                  @db.Uuid
  sellerId             String                  @db.Uuid
  status               TransactionStatus       @default(PENDING)
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
  exchangeConfirmation ExchangeConfirmation?
  buyer                User                    @relation("TransactionBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  listing              Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reservation          Reservation?            @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seller               User                    @relation("TransactionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  qrSessions           QRVerificationSession[]

  @@index([status])
  @@index([createdAt])
}

model QRVerificationSession {
  id            String             @id @default(uuid()) @db.Uuid
  transactionId String             @db.Uuid
  sellerId      String             @db.Uuid
  buyerId       String             @db.Uuid
  nonce         String             @unique @default(uuid()) @db.Uuid
  signedToken   String
  status        QRSessionStatus    @default(ACTIVE)
  expiresAt     DateTime
  scannedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  transaction   ListingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ExchangeConfirmation {
  id                String             @id @default(uuid()) @db.Uuid
  transactionId     String             @unique @db.Uuid
  confirmedByBuyer  DateTime?
  confirmedBySeller DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  transaction       ListingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  DRAFT
  REMOVED
}

enum ConversationStage {
  NEGOTIATING
  RESERVED
  MEETUP_PLANNED
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  SYSTEM
  MEETUP
  RESERVATION
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum QRSessionStatus {
  ACTIVE
  SCANNED
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  MEETUP_PENDING
  QR_GENERATED
  QR_SCANNED
  EXCHANGE_CONFIRMED
  COMPLETED
  CANCELLED
}
